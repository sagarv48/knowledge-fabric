{
  "name": "Knowledge Fabric Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableCache": true
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.ruffEnabled": true,
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "mtxr.sqltools"
      ]
    }
  },
  "postCreateCommand": "docker compose up -d postgres tika && pip install -e .[dev]",
  "forwardPorts": [8080, 5432, 9998],
  "portsAttributes": {
    "8080": {
      "label": "Knowledge Fabric API / Web UI",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "PostgreSQL (pgvector)"
    },
    "9998": {
      "label": "Apache Tika"
    }
  }
}
